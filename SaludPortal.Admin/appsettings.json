{
  "ConnectionStrings": {
    "LogsDb": ""
  },
  "AdminUsers": [],
  "LogIngestion": {
    "ApiKey": "",
    "MaxPayloadBytes": 32768,
    "RateLimit": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Telemetry": {
      "AllowedEventTypes": [ "view_page", "click", "download_pdf", "view_image", "copy_link" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
