{
  "ConnectionStrings": {
    "LogsDb": "Host=localhost;Port=5432;Database=salud_logs;Username=salud;Password=salud_pass"
  },
  "AdminUsers": [
    { "Email": "admin@saludportal.local", "Password": "Admin1234!" }
  ],
  "LogIngestion": {
    "ApiKey": "saludportal-logs-internal-key-dev",
    "MaxPayloadBytes": 32768,
    "RateLimit": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Telemetry": {
      "AllowedEventTypes": [ "view_page", "click", "download_pdf", "view_image", "copy_link" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
